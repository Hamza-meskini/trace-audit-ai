# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Lock files (regenerated on install) ──────────────────────
package-lock.json
bun.lock

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
*.local

# ── Wrangler / Cloudflare ────────────────────────────────────
.wrangler/
.dev.vars

# ── Editor & IDE files ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.bak

# ── OS generated files ──────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Secrets & env files ─────────────────────────────────────
.env
.env.*
!.env.example
!backend/.env.example
backend/.env
backend/.env.*

# ── Python virtual environments (anywhere) ───────────────────
venv/
.venv/
.venv-docling/
backend/venv/
env/

# ── Python bytecode & caches (anywhere in tree) ─────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
*.sqlite3
.mypy_cache/
.ruff_cache/
*.egg-info/
build/

# ── Database files ───────────────────────────────────────────
*.db
traceaudit.db
backend/traceaudit.db

# ── Uploads & user data (runtime generated) ──────────────────
uploads/
backend/uploads/
backend/chroma_data/
.cache/
backend/.cache/

# ── Temporary & scratch directories ─────────────────────────
tmp/
**/tmp/
.review-tmp/
**/.review-tmp/
sample_documents/
.pytest-tmp-*/
**/.pytest-tmp-*/
mlruns/
**/mlruns/
.trash/
**/.trash/

# ── Generated documents ─────────────────────────────────────
TraceAudit_AI_Product_Strategy_Report.docx
*.docx
*.xlsx

# ── Office / Excel temporary lock files ──────────────────────
~$*
*.tmp

# ── Evaluation results & outputs (generated, not source) ────
# All run outputs, checkpoints, logs, traces, and experiment subdirs.
# Benchmark source data & pipeline code live in evaluation/*_benchmark/.
evaluation/results/

# ── Evaluation runner scripts (generated) ────────────────────
evaluation/*.ps1

# ── Codex visualizations / analysis artifacts ────────────────
.codex/
