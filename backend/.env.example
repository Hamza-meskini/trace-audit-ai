# TraceAudit AI — Backend environment variables
# Copy this file to .env and fill in your API keys

# Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Active LLM Model: gemini-3.7-flash (recommended) or gemini-3.1-pro-preview
LLM_MODEL=gemini-3.7-flash
LLM_PROVIDER=gemini

# Gemini Thinking Configuration (Options: HIGH, MEDIUM, LOW, MINIMAL)
# Set to HIGH for maximum reasoning depth on requirements verification
GEMINI_THINKING_LEVEL=HIGH

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=

# Debug mode
DEBUG=true

# Database (SQLite, zero configuration)
DATABASE_URL=sqlite+aiosqlite:///./traceaudit.db

# Upload directory
UPLOAD_DIR=./uploads

# CORS origins (frontend dev server)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
