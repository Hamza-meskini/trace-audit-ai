# TraceAudit AI — Backend environment variables
# Copy this file to .env and fill in your API keys

# Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional vision fallbacks. Gemini is tried first, then Groq, then HF.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Fine-grained token with "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Active LLM Model: gemini-3.7-flash (recommended) or gemini-3.1-pro-preview
LLM_MODEL=gemini-3.7-flash
LLM_PROVIDER=gemini

# Split-model requirement extraction. The caller-selected model discovers
# requirements; GLM 5.3 plans and constructs their atomic condition contracts.
ATOMIC_DECOMPOSITION_MODEL=z-ai/glm-5.3-free
ATOMIC_DECOMPOSITION_FALLBACK_MODEL=system.ai.llama-4-maverick
ATOMIC_DECOMPOSITION_THINKING_LEVEL=PROVIDER_DEFAULT
ATOMIC_CONSTRUCTION_MODE=direct
ATOMIC_CONTRACT_CONCURRENCY=4
LLM_GLOBAL_CONCURRENCY=8
AUDIT_RETRIEVAL_CONCURRENCY=4
AUDIT_VERIFICATION_BATCH_CONCURRENCY=2
AUDIT_CITATION_CONCURRENCY=4
AUDIT_RETRY_CONCURRENCY=3
AUDIT_RERANKER_CONCURRENCY=4
AUDIT_WORKER_CONCURRENCY=2
AUDIT_WORKER_POLL_SECONDS=1
# Increment this after a semantic prompt/schema/policy change to invalidate
# persisted verification and reranker results.
AUDIT_CACHE_VERSION=audit-v1
AUDIT_CACHE_MAX_ENTRIES=50000

# Document parser: databricks-auto uses Databricks Document AI and falls back
# to the local auto parser. Other choices: auto, databricks, pymupdf, docling.
TRACEAUDIT_DOCUMENT_PARSER=auto

# Gemini Thinking Configuration (Options: HIGH, MEDIUM, LOW, MINIMAL)
# Set to HIGH for maximum reasoning depth on requirements verification
GEMINI_THINKING_LEVEL=HIGH

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=

# Optional: Databricks AI Gateway (MLflow Model Serving)
DATABRICKS_TOKEN=
DATABRICKS_VISION_MODEL=system.ai.llama-4-maverick
DATABRICKS_REASONING_TIMEOUT_SECONDS=300
DATABRICKS_BASE_URL=https://<workspace-id>.cloud.databricks.com/ai-gateway/mlflow/v1
DATABRICKS_MODEL=system.ai.qwen35-122b-a10b
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_DOCUMENT_VOLUME=/Volumes/<catalog>/<schema>/<volume>
# Empty uses backend/.cache/databricks_document_ai.
DATABRICKS_DOCUMENT_CACHE_DIR=
# Focused extraction runs only after retrieval; keep false until latency/cost
# have been measured on your own corpus.
DATABRICKS_TARGETED_EXTRACTION_ENABLED=false
DATABRICKS_TARGETED_EXTRACTION_CONCURRENCY=2
DATABRICKS_TARGETED_EXTRACTION_MIN_CONFIDENCE=0.80
DATABRICKS_TARGETED_EXTRACTION_MAX_INPUT_CHARS=800000
DATABRICKS_TARGETED_EXTRACTION_MAX_CANDIDATES=24
DATABRICKS_TARGETED_EXTRACTION_RETRY_UNCOVERED=true

# Optional Databricks-native search. ai_prep_search is Beta, so it and the
# managed index are independently switchable. Run
# evaluation/setup_databricks_ai_search.py after filling the three UC fields.
DATABRICKS_AI_PREP_SEARCH_ENABLED=false
DATABRICKS_AI_PREP_SEARCH_REQUIRED=false
DATABRICKS_AI_SEARCH_ENABLED=false
DATABRICKS_AI_SEARCH_ENDPOINT=auditrace-search
DATABRICKS_AI_SEARCH_INDEX=<catalog>.<schema>.auditrace_chunks_index
DATABRICKS_AI_SEARCH_SOURCE_TABLE=<catalog>.<schema>.auditrace_search_chunks
DATABRICKS_AI_SEARCH_EMBEDDING_MODEL=databricks-gte-large-en
DATABRICKS_AI_SEARCH_RERANK_ENABLED=true
DATABRICKS_AI_SEARCH_CANDIDATE_COUNT=30
DATABRICKS_AI_SEARCH_MAX_QUERIES_PER_REQUIREMENT=8
DATABRICKS_AI_SEARCH_SYNC_TIMEOUT_SECONDS=90
# Optional custom cross-encoder deployed through Databricks Model Serving.
DATABRICKS_CUSTOM_RERANKER_ENABLED=false
DATABRICKS_CUSTOM_RERANKER_ENDPOINT=bge-reranker-v2-m3
DATABRICKS_CUSTOM_RERANKER_CANDIDATE_COUNT=20
DATABRICKS_CUSTOM_RERANKER_MAX_QUERIES=1
DATABRICKS_CUSTOM_RERANKER_TIMEOUT_SECONDS=180
DATABRICKS_CUSTOM_RERANKER_BATCH_SIZE=4

# Optional traces and benchmark metric logging in the Databricks MLflow
# experiment named below. Install backend/requirements-mlflow.txt to enable it.
DATABRICKS_MLFLOW_TRACING_ENABLED=false
DATABRICKS_MLFLOW_EXPERIMENT=/Shared/auditrace

# Optional: TokenRouter (OpenAI-compatible Multi-Model Gateway)
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=z-ai/glm-5.3-free

# Optional: Alibaba Cloud Model Studio / DashScope Responses API
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash

# Optional: OpenRouter vision router
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=openrouter/free
GEMINI_VISION_MODEL=models/gemini-3.6-flash

# Optional: Custom OpenAI-compatible Base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# Focused safety calls. The adjudicator should normally differ from the
# primary reasoning model. Citation grounding returns extractive spans only.
SECONDARY_ADJUDICATOR_ENABLED=true
SECONDARY_ADJUDICATOR_MODEL=system.ai.qwen35-122b-a10b
CITATION_GROUNDING_ENABLED=true
CITATION_GROUNDING_MODEL=system.ai.qwen35-122b-a10b


# Debug mode
DEBUG=true

# Database (SQLite, zero configuration)
DATABASE_URL=sqlite+aiosqlite:///./traceaudit.db

# Upload directory
UPLOAD_DIR=./uploads

# CORS origins (frontend dev server)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
