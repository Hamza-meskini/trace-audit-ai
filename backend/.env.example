# TraceAudit AI — Backend environment variables
# Copy this file to .env and fill in your API keys

# Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional vision fallbacks. Gemini is tried first, then Groq, then HF.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Fine-grained token with "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Active LLM Model: gemini-3.7-flash (recommended) or gemini-3.1-pro-preview
LLM_MODEL=gemini-3.7-flash
LLM_PROVIDER=gemini

# Document parser: auto prefers Docling and falls back to PyMuPDF layout.
# Use pymupdf for a lightweight deployment or docling to require Docling.
TRACEAUDIT_DOCUMENT_PARSER=auto

# Gemini Thinking Configuration (Options: HIGH, MEDIUM, LOW, MINIMAL)
# Set to HIGH for maximum reasoning depth on requirements verification
GEMINI_THINKING_LEVEL=HIGH

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=

# Optional: Databricks AI Gateway (MLflow Model Serving)
DATABRICKS_TOKEN=
DATABRICKS_BASE_URL=https://<workspace-id>.cloud.databricks.com/ai-gateway/mlflow/v1
DATABRICKS_MODEL=system.ai.qwen35-122b-a10b

# Focused safety calls. The adjudicator should normally differ from the
# primary reasoning model. Citation grounding returns extractive spans only.
SECONDARY_ADJUDICATOR_ENABLED=true
SECONDARY_ADJUDICATOR_MODEL=system.ai.qwen35-122b-a10b
CITATION_GROUNDING_ENABLED=true
CITATION_GROUNDING_MODEL=system.ai.qwen35-122b-a10b


# Debug mode
DEBUG=true

# Database (SQLite, zero configuration)
DATABASE_URL=sqlite+aiosqlite:///./traceaudit.db

# Upload directory
UPLOAD_DIR=./uploads

# CORS origins (frontend dev server)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
